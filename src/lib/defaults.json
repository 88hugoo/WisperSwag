  "writing": {
    "active_mode": "natural",
    "modes": [
      {
        "id": "natural",
        "name": "Natural",
        "description": "Conserva tu tono. Limpia muletillas, repeticiones y puntuación.",
        "builtin": true,
        "local": {
          "final_period": "keep",
          "lowercase_start": false,
          "remove_discourse_markers": false,
          "structure": "plain",
          "capitalize": true
        },
        "template": "",
        "ai_enabled": true,
        "ai_instructions": "Corrige solo errores evidentes de transcripción, puntuación, mayúsculas y gramática. Conserva las palabras, el tono y el estilo del usuario. Si el usuario se corrige a sí mismo al hablar («a las tres, no, a las cuatro»), conserva solo la versión corregida. No reformules, no resumas y no añadas nada.",
        "temperature": 0.1
      },
      {
        "id": "professional",
        "name": "Profesional",
        "description": "Texto de trabajo claro y sin coloquialismos.",
        "builtin": true,
        "local": {
          "final_period": "keep",
          "lowercase_start": false,
          "remove_discourse_markers": true,
          "structure": "paragraphs",
          "capitalize": true
        },
        "template": "",
        "ai_enabled": true,
        "ai_instructions": "Reescribe el texto con un tono profesional, claro y directo, adecuado para el entorno laboral. Mantén toda la información y la intención. Elimina muletillas y coloquialismos. No añadas datos nuevos.",
        "temperature": 0.3
      },
      {
        "id": "concise",
        "name": "Conciso",
        "description": "Elimina redundancias y rodeos sin perder información.",
        "builtin": true,
        "local": {
          "final_period": "keep",
          "lowercase_start": false,
          "remove_discourse_markers": true,
          "structure": "plain",
          "capitalize": true
        },
        "template": "",
        "ai_enabled": true,
        "ai_instructions": "Haz el texto lo más breve y directo posible sin perder ninguna información relevante: elimina redundancias, rodeos, repeticiones y frases de relleno.",
        "temperature": 0.2
      },
      {
        "id": "formal",
        "name": "Formal",
        "description": "Registro cuidado y respetuoso.",
        "builtin": true,
        "local": {
          "final_period": "keep",
          "lowercase_start": false,
          "remove_discourse_markers": true,
          "structure": "paragraphs",
          "capitalize": true
        },
        "template": "",
        "ai_enabled": true,
        "ai_instructions": "Reescribe el texto con un registro formal y cuidado. En español, usa el trato de usted salvo que el texto indique lo contrario. Mantén el contenido íntegro y no añadas información.",
        "temperature": 0.3
      },
      {
        "id": "informal",
        "name": "Informal",
        "description": "Tono cercano y conversacional.",
        "builtin": true,
        "local": {
          "final_period": "remove_if_single_sentence",
          "lowercase_start": false,
          "remove_discourse_markers": false,
          "structure": "plain",
          "capitalize": true
        },
        "template": "",
        "ai_enabled": true,
        "ai_instructions": "Reescribe el texto con un tono cercano, natural y conversacional. Mantén el contenido. No uses emojis salvo que el usuario los mencione.",
        "temperature": 0.5
      },
      {
        "id": "email",
        "name": "Correo electrónico",
        "description": "Saludo, cuerpo en párrafos y despedida.",
        "builtin": true,
        "local": {
          "final_period": "keep",
          "lowercase_start": false,
          "remove_discourse_markers": true,
          "structure": "email",
          "capitalize": true
        },
        "template": "",
        "ai_enabled": true,
        "ai_instructions": "Da formato de correo electrónico: saludo en su propia línea si el usuario lo dicta, cuerpo en párrafos breves y despedida en una línea aparte. Corrige el estilo para que sea claro. No inventes nombres, firmas, asuntos ni datos que no se hayan dictado.",
        "temperature": 0.3
      },
      {
        "id": "messages",
        "name": "Mensajes",
        "description": "Breve y natural para chats. Sin punto final en frases sueltas.",
        "builtin": true,
        "local": {
          "final_period": "remove_if_single_sentence",
          "lowercase_start": false,
          "remove_discourse_markers": false,
          "structure": "plain",
          "capitalize": true
        },
        "template": "",
        "ai_enabled": true,
        "ai_instructions": "Optimiza el texto para un mensaje de chat: breve, natural y sin formalidades innecesarias. Si es una sola frase, no pongas punto final.",
        "temperature": 0.3
      },
      {
        "id": "code",
        "name": "Programación",
        "description": "Respeta términos técnicos; símbolos dictados y camelCase/snake_case.",
        "builtin": true,
        "local": {
          "final_period": "remove_if_single_sentence",
          "lowercase_start": false,
          "remove_discourse_markers": false,
          "structure": "code",
          "capitalize": false
        },
        "template": "",
        "ai_enabled": true,
        "ai_instructions": "El texto se usará en un entorno de programación. Respeta exactamente nombres de variables, funciones, comandos, rutas y términos técnicos (no los traduzcas). Convierte símbolos dictados en su forma escrita cuando sea inequívoco. Si el usuario dicta código, devuelve solo el código, sin bloques Markdown.",
        "temperature": 0.0
      },
      {
        "id": "notes",
        "name": "Notas",
        "description": "Organiza las ideas en viñetas.",
        "builtin": true,
        "local": {
          "final_period": "keep",
          "lowercase_start": false,
          "remove_discourse_markers": true,
          "structure": "bullets",
          "capitalize": true
        },
        "template": "",
        "ai_enabled": true,
        "ai_instructions": "Organiza el contenido como apuntes: viñetas breves que empiezan por «- », agrupando ideas relacionadas. Conserva todos los datos (cifras, nombres, fechas). No añadas títulos inventados.",
        "temperature": 0.2
      },
      {
        "id": "tasks",
        "name": "Lista de tareas",
        "description": "Convierte lo dictado en tareas «- [ ]».",
        "builtin": true,
        "local": {
          "final_period": "keep",
          "lowercase_start": false,
          "remove_discourse_markers": true,
          "structure": "checklist",
          "capitalize": true
        },
        "template": "",
        "ai_enabled": true,
        "ai_instructions": "Convierte la explicación dictada en una lista de tareas accionables. Cada tarea en una línea que empiece por «- [ ] », con verbo en infinitivo y los datos concretos (fechas, responsables, cifras) que se hayan dicho. No inventes tareas.",
        "temperature": 0.1
      },
      {
        "id": "creative",
        "name": "Creativo",
        "description": "Estilo más elaborado y expresivo.",
        "builtin": true,
        "local": {
          "final_period": "keep",
          "lowercase_start": false,
          "remove_discourse_markers": false,
          "structure": "paragraphs",
          "capitalize": true
        },
        "template": "",
        "ai_enabled": true,
        "ai_instructions": "Mejora la expresividad, la riqueza léxica y el ritmo del texto con un estilo más elaborado, sin cambiar el significado ni añadir hechos nuevos.",
        "temperature": 0.8
      },
      {
        "id": "custom",
        "name": "Personalizado",
        "description": "Tus propias instrucciones.",
        "builtin": true,
        "local": {
          "final_period": "keep",
          "lowercase_start": false,
          "remove_discourse_markers": false,
          "structure": "plain",
          "capitalize": true
        },
        "template": "",
        "ai_enabled": true,
        "ai_instructions": "",
        "temperature": 0.3
      }
    ],
