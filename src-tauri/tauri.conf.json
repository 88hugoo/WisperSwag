{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wispr Swag",
  "mainBinaryName": "wispr-swag",
  "version": "0.1.0",
  "identifier": "com.wisprswag.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: asset: http://asset.localhost; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "publisher": "Wispr Swag",
    "category": "Productivity",
    "shortDescription": "Dictado por voz para todo Windows",
    "longDescription": "Wispr Swag convierte tu voz en texto en cualquier aplicación de Windows con un atajo de teclado, con reconocimiento local y procesamiento de texto avanzado.",
    "copyright": "© 2026 Wispr Swag",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Spanish",
          "English"
        ],
        "displayLanguageSelector": false,
        "startMenuFolder": "Wispr Swag",
        "installerIcon": "icons/icon.ico",
        "installerHooks": "windows/hooks.nsh"
      },
      "wix": {
        "language": [
          "es-ES",
          "en-US"
        ]
      }
    }
  }
}
